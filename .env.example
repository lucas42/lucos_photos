# Standard lucos vars (provided automatically by lucos_creds)
SYSTEM=lucos_photos
ENVIRONMENT=
PORT=
APP_ORIGIN=

# PostgreSQL (POSTGRES_USER is hardcoded in docker-compose; host/port/db are hardcoded in shared/lucos_photos_common/database.py)
POSTGRES_PASSWORD=

# External lucos services
LOGANNE_ENDPOINT=
LUCOS_CONTACTS_URL=
KEY_LUCOS_CONTACTS=
KEY_LUCOS_ARACHNE=

# Aithne session auth
# AITHNE_ORIGIN: browser-facing origin — sets iss validation and login redirect
AITHNE_ORIGIN=
# AITHNE_JWKS_URL: server-side JWKS fetch address (overrides AITHNE_ORIGIN for key fetch only)
# Set in dev so bridge-network containers can reach aithne; unset in production
AITHNE_JWKS_URL=

# API authentication — semicolon-separated list of "$system:$environment=$key"
CLIENT_KEYS=
